# Frontend settings. Copy to .env.local (all optional: the defaults below work for local development).
# Where the Next.js server proxies /api/backend/* requests. Default: http://localhost:5000/api in
# development; set it to your deployed API (e.g. https://your-api.onrender.com/api) in production.
BACKEND_API_URL=http://localhost:5000/api
# There is no NEXT_PUBLIC_API_URL: the browser always calls the same-origin proxy.
# Google sign-in needs no frontend variable: the client ID comes from GOOGLE_CLIENT_ID in backend/.env.

# Shop details shown in the footer, contact page and emails
NEXT_PUBLIC_SITE_NAME=SwiftCart
NEXT_PUBLIC_DEFAULT_COUNTRY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
