{
  "name": "swiftcart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev -p 3001",
    "dev:backend": "npm --prefix backend run dev",
    "setup:google": "node scripts/setup-google.cjs",
    "package:zip": "node scripts/make-submission.cjs",
    "test:auth:browser": "playwright test tests/browser/google-auth.spec.js",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.556.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
