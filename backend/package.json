{
  "name": "swiftcart-backend",
  "version": "1.0.0",
  "description": "Full-stack Node.js backend for SwiftCart E-commerce",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:auth": "node --test tests/google-auth.test.js",
    "test:draw": "node --test tests/draw-flow.test.js",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:catalog": "node scripts/seedCatalog.js",
    "db:seed-sql": "node scripts/exportSeedSql.js",
    "db:init": "node scripts/initDb.js",
    "db:schema": "node scripts/initDb.js --dump --dump-only",
    "test": "node --test tests/google-auth.test.js tests/draw-flow.test.js tests/security.test.js tests/order-flow.test.js tests/features.test.js tests/catalog-data.test.js",
    "test:security": "node --test tests/security.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
