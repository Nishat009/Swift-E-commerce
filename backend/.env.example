PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/swiftcart
FRONTEND_URL=http://localhost:3001

# Use different random secrets, each at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Cloud > Google Auth Platform > Clients > Web application.
# Authorized JavaScript origin: http://localhost:3001
# Public OAuth client ID only. This GIS sign-in flow does not use a client secret.
GOOGLE_CLIENT_ID=

# Email (free SMTP - see backend/EMAIL.md). Leave blank to disable emails (a warning is logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SwiftCart <you@example.com>"
# Where contact-form messages are delivered (defaults to SMTP_USER). Also the reply-to address
# of emails staff send to customers from the admin panel.
CONTACT_EMAIL=
# Store inbox for new-order and return-request alerts (defaults to CONTACT_EMAIL, then SMTP_USER)
ORDER_ALERT_EMAIL=

# In development without SMTP, emails go to a free Ethereal test inbox and the log prints a
# preview link. Set to false to switch that off.
EMAIL_ETHEREAL=true

# Dev only: return OTP / reset codes in API responses. Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH_CODES=false

# Auth cookies. Production defaults to SameSite=None + Secure (frontend and API on different sites).
# Use "lax" when the API is served from the same site as the frontend (e.g. api.yourshop.com + yourshop.com).
COOKIE_SAMESITE=

# Unpaid bKash / card orders are cancelled (stock and coupon released) after this many minutes
ORDER_PAYMENT_HOLD_MINUTES=30
# Customers can ask to return a delivered order for this many days (shipping & returns policy)
RETURN_WINDOW_DAYS=7

# Production: product image uploads need Cloudinary, otherwise they are lost on redeploy
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chat messages are deleted automatically after this many days (only a hash of the sender's IP is kept)
CHAT_RETENTION_DAYS=180

# When the database has no public product at startup, the fashion demo catalog is added (insert-only,
# nothing is deleted). Set to false on a real shop to keep an empty store empty.
AUTO_SEED_CATALOG=true

# ---- Payments (all optional) ----
# Admin panel > Payment Settings can switch gateways on/off and save keys; a key saved there
# wins over the value below. Saved keys are encrypted (AES-256-GCM) with PAYMENT_SETTINGS_KEY:
# a separate random secret of 32+ characters, generated like JWT_SECRET above:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production to save keys from the admin panel (development falls back to JWT_SECRET).
PAYMENT_SETTINGS_KEY=
# Public URL of THIS backend (gateways redirect customers back here)
BACKEND_URL=http://localhost:5000
# USD -> BDT rate used for bKash (prices are stored in USD)
BDT_PER_USD=120

# Stripe Checkout (card). Use an sk_test_ key while testing.
# Development only: fake bKash/Card gateway (no real accounts needed). Ignored when NODE_ENV=production.
PAYMENT_MOCK=false
STRIPE_SECRET_KEY=
# Optional: only if you add a Stripe webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=

# bKash tokenized checkout. Leave BKASH_BASE_URL empty for the sandbox.
# Live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

# One-click "Guest login" and "Admin login" buttons on the login page, for demos / reviewers.
# WARNING: with "admin" enabled, ANYONE who opens the site can use the admin panel.
# Keep it off on a real shop, or use DEMO_LOGIN_ROLES=customer to show only the guest button.
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_ROLES=customer,admin
DEMO_CUSTOMER_EMAIL=guest@swiftcart.demo
DEMO_ADMIN_EMAIL=admin@swiftcart.demo
# Optional (8+ characters): the demo accounts can then also sign in with email + password, and the
# login pages show these credentials. Leave empty for button-only access.
# WARNING: with "admin" in DEMO_LOGIN_ROLES, this password is effectively public. The demo admin is
# read-mostly (no role changes, deletions, order status changes, customer emails, gateway tests,
# payment settings or wallet adjustments), but it can still see customer orders and accounts.
DEMO_PASSWORD=

# Password for admin@email.com and user@email.com created by "seed" / "seed:admin" (8+ characters).
# Leave empty and each seed run picks a random password and prints it.
SEED_PASSWORD=
